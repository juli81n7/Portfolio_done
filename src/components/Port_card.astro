---
import "swiper/css";
import "swiper/css/effect-cards";
import { Swiper, SwiperSlide } from "swiper/react";
import SwiperCore, { EffectCards, Navigation, Pagination } from "swiper";
import { supabase } from "../lib/supabaseClient";

// Register Swiper modules
SwiperCore.use([EffectCards, Navigation, Pagination]);

// Fetch projects from Supabase
const { data: projects, error } = await supabase
  .from("portfolio")
  .select("slug, name, description");

if (error) throw new Error(error.message);

// For each project, get the wide image URL from the Startimg folder
const images = projects.map((project) => ({
  url: supabase.storage
    .from("portfolio")
    .getPublicUrl(`Startimg/${project.slug}_wide.webp`).data.publicUrl,
  alt: project.name,
  description: project.description,
}));
---

<div class="w-full max-w-lg mx-auto my-8">
  <Swiper
    effect="cards"
    grabCursor={true}
    navigation
    pagination={{ clickable: true }}
    style="width:100%;height:500px;"
  >
    {
      images.map((img, i) => (
        <SwiperSlide key={i}>
          <div class="flex flex-col items-center justify-end h-full p-4 bg-white rounded-xl shadow-lg">
            <img
              src={img.url}
              alt={img.alt}
              class="w-full h-72 object-cover rounded-lg"
            />
            <h3 class="mt-4 text-lg font-semibold text-gray-800 text-center">
              {img.alt}
            </h3>
            <p class="mt-2 text-sm text-gray-600 text-center">
              {img.description}
            </p>
          </div>
        </SwiperSlide>
      ))
    }
  </Swiper>
</div>

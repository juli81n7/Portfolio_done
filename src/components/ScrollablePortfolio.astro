---
import Cards from "./Cards.astro";
const { link } = Astro.props;
import "../styles/general.css";
import "../styles/general.css";
---

<div class="col-start-2 ml-10 relative flex justify-between items-center">
  <div class="sort flex gap-2 w-full">
    <div class="sortbtn" data-tag="all">Alle</div>
    <div class="sortbtn" data-tag="webdesign">Webdesign</div>
    <div class="sortbtn" data-tag="frontend">Frontend</div>
    <div class="sortbtn" data-tag="branddesign">Branddesign</div>
    <div class="sortbtn" data-tag="brandudvikling">Brandudvikling</div>
  </div>
  <div class="navigate_projects">
    <div class="prev_project">
      <svg
        id="Layer_2"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 16.4 16.4"
        ><defs></defs><g id="Layer_1-2"
          ><polygon
            class="cls-1"
            points="16.6 7.2 4 7.2 10.2 1.5 8.8 0 0 8.2 8.8 16.4 10.2 14.9 4 9.2 16.6 9.2 16.6 7.2"
          ></polygon></g
        ></svg
      >
    </div>
    <div class="next_project">
      <svg
        id="Layer_2"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 16.4 16.4"
        ><defs
          ><style>
            .cls-1 {
              fill: #191919;
            }
          </style></defs
        ><g id="Layer_1-2"
          ><polygon
            class="cls-1"
            points="16.6 7.2 4 7.2 10.2 1.5 8.8 0 0 8.2 8.8 16.4 10.2 14.9 4 9.2 16.6 9.2 16.6 7.2"
          ></polygon></g
        ></svg
      >
    </div>
  </div>
</div>
<section class="shelf full_width full_width">
  <div class="wrapper w-full flex" id="project-wrapper">
    <Cards link={link} />
  </div>
</section>
<section class="shelf mobile">
  <div class="wrapper">
    <Cards link={link} />
  </div>
</section>

<style>
  .card.hide {
    display: none !important;
  }

  section {
    margin-top: 1rem;
  }

  .shelf {
    width: 100%;
    overflow: hidden;
    overflow-x: scroll;
    scroll-behavior: smooth;
    margin-top: 1rem;
    cursor: url(/svg/move_white.svg), auto !important;
    padding-bottom: 1rem;
    scroll-snap-type: x mandatory;
    grid-column: 2;
  }

  .mobile {
    display: none;
  }

  @media (max-width: 800px) {
    .pc {
      display: none;
    }
    .mobile {
      display: block;
    }
  }
  & .full_width {
  }

  .wrapper {
    display: flex;
    gap: 0.5rem;

    @media (width>500px) {
      --gap: 0rem;
      --content-width: 800px;
    }
  }
  .wrapper {
    width: 100%;
    overflow-x: auto;
    display: flex;
    gap: 0.5rem;
    border: 2px solid red; /* for visual debugging */
    scroll-behavior: smooth;
  }
  .wrapper:after {
    content: "";
    padding-right: 5rem;
  }
  .navigate_projects {
    display: flex;
    align-items: end;
    gap: 0.5rem;

    & > * {
      cursor: pointer;
      padding: 0.5rem 1rem;
      border-radius: 0.5rem;
      background-color: var(--secondary);
      height: 1rem;
      width: 1rem;

      &:hover {
        background-color: var(--accent);
      }
    }
    & .next_project {
      & svg {
        rotate: 180deg;
        & path {
          fill: var(--secondary);
        }
      }
    }
  }

  .sortbtn {
    width: fit-content;
    justify-content: center;
    padding: 0.6rem 1rem 0.6rem 1rem;
    text-align: center;
    font-family: roc-grotesk, sans-serif;
    font-weight: 400;
    font-size: 0.8rem;
    background-color: var(--primary);
    border: var(--secondary) solid 1.5px;
    color: var(--secondary);
    padding: 0.4rem;
    padding-left: 1rem;
    padding-right: 1rem;
    border-radius: 0.5rem;
    transition: 0.5s ease;
    cursor: pointer;
    overflow: hidden;
  }

  .sortbtn.active {
    background-color: var(--secondary);
    color: var(--primary);
  }
</style>
<script is:inline>
  // Sorting
  const sortBtns = document.querySelectorAll(".sortbtn");
  const cards = document.querySelectorAll(".card");

  sortBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      sortBtns.forEach((b) => b.classList.remove("active"));
      btn.classList.add("active");
      const tag = btn.dataset.tag;
      cards.forEach((card) => {
        if (tag === "all" || card.classList.contains(tag)) {
          card.classList.remove("hide");
        } else {
          card.classList.add("hide");
        }
      });
    });
  });

  const nextProject = document.querySelector(".next_project");
  const prevProject = document.querySelector(".prev_project");

  const shelf = document.querySelector(".wrapper");

  nextProject.addEventListener("click", () => {
    console.log("next_project");

    shelf.scrollLeft += 800;
  });
  prevProject.addEventListener("click", () => {
    console.log("next_project");

    shelf.scrollLeft -= 800;
  });
</script>

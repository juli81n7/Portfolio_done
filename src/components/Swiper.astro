---
import "swiper/css";
import "swiper/css/effect-cards";
import { supabase } from "../lib/supabaseClient";

// Fetch projects from Supabase
const { data: projects, error } = await supabase
  .from("portfolio") // <-- check your bucket name case!
  .select("slug, name, description");

if (error) throw new Error(error.message);

const images = projects.map((project) => ({
  url: supabase.storage
    .from("Portfolio") // <-- check your bucket name case!
    .getPublicUrl(`cardImgs/${project.slug}_wide.webp`).data.publicUrl,
  alt: project.name,
  description: project.description,
}));
---

<div class="w-full max-w-lg mx-auto my-8">
  <div class="swiper mySwiper">
    <div class="swiper-wrapper">
      {
        images.map((img) => (
          <div class="swiper-slide">
            <div class="flex flex-col items-center justify-end h-full p-4 bg-white rounded-xl shadow-lg">
              <img
                src={img.url}
                alt={img.alt}
                class="w-full h-72 object-cover rounded-lg"
              />
              <h3 class="mt-4 text-lg font-semibold text-gray-800 text-center">
                {img.alt}
              </h3>
              <p class="mt-2 text-sm text-gray-600 text-center">
                {img.description}
              </p>
            </div>
          </div>
        ))
      }
    </div>
    <div class="swiper-pagination"></div>
    <div class="swiper-button-next"></div>
    <div class="swiper-button-prev"></div>
  </div>
</div>

<script is:inline>
  import Swiper, { EffectCards, Navigation, Pagination } from "swiper";

  document.addEventListener("DOMContentLoaded", () => {
    new Swiper(".mySwiper", {
      effect: "cards", // <-- enable card effect!
      grabCursor: true,
      navigation: {
        nextEl: ".swiper-button-next",
        prevEl: ".swiper-button-prev",
      },
      pagination: {
        el: ".swiper-pagination",
        clickable: true,
      },
      modules: [EffectCards, Navigation, Pagination],
    });
  });
</script>

---
// src/components/ExploringGrid.astro

const items = Array.from({ length: 20 }, (_, i) => ({
  id: i,
  title: `Item ${i + 1}`,
  desc: "Explore me",
}));
---

<section class="relative w-full min-h-screen bg-slate-900 text-slate-100 flex items-center justify-center overflow-hidden">
  <div class="pointer-events-none fixed inset-0 bg-[radial-gradient(circle_at_var(--mx,50%)_var(--my,50%),rgba(148,163,184,0.25),transparent_60%)] transition-[background-position] duration-200 ease-out"></div>

  <div
    class="relative grid gap-4 grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 p-6 sm:p-10 max-w-6xl w-full"
    data-exploring-grid
  >
    {items.map((item) => (
      <article
        class="group relative bg-slate-800/70 border border-slate-700/70 rounded-xl p-4 sm:p-5 backdrop-blur-md shadow-[0_18px_60px_rgba(15,23,42,0.85)] overflow-hidden transition-all duration-300 ease-out
               hover:border-sky-400/80 hover:bg-slate-800/90"
        data-exploring-item
      >
        <div class="absolute inset-px rounded-[0.7rem] bg-gradient-to-br from-sky-500/0 via-sky-500/5 to-sky-500/0 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none" />

        <div class="relative z-10 space-y-2">
          <h3 class="text-sm sm:text-base font-semibold tracking-tight group-hover:text-sky-100">
            {item.title}
          </h3>
          <p class="text-xs sm:text-sm text-slate-400 group-hover:text-slate-200/90">
            {item.desc}
          </p>
        </div>

        <div class="absolute -inset-10 opacity-0 group-hover:opacity-60 bg-[radial-gradient(circle_at_top,var(--glow-color,rgba(56,189,248,0.7)),transparent_60%)] transition-opacity duration-300 pointer-events-none" />
      </article>
    ))}
  </div>

  <script is:inline>
    // Simple hover-parallax + spotlight effect
    const grid = document.querySelector("[data-exploring-grid]");
    if (grid) {
      const items = grid.querySelectorAll("[data-exploring-item]");

      const handleMove = (e) => {
        const rect = grid.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;

        // normalized -1..1
        const nx = (x / rect.width) * 2 - 1;
        const ny = (y / rect.height) * 2 - 1;

        // move radial background center
        const globalX = (x / rect.width) * 100;
        const globalY = (y / rect.height) * 100;
        document.documentElement.style.setProperty("--mx", globalX + "%");
        document.documentElement.style.setProperty("--my", globalY + "%");

        items.forEach((item) => {
          const itemRect = item.getBoundingClientRect();
          const itemCenterX = itemRect.left + itemRect.width / 2;
          const itemCenterY = itemRect.top + itemRect.height / 2;
          const dx = (e.clientX - itemCenterX) / itemRect.width;
          const dy = (e.clientY - itemCenterY) / itemRect.height;

          // depth parallax
          const depth = 8;
          const rotateX = dy * -depth;
          const rotateY = dx * depth;
          const translateZ = 10;

          item.style.transform = `
            perspective(700px)
            rotateX(${rotateX}deg)
            rotateY(${rotateY}deg)
            translate3d(${dx * 10}px, ${dy * 10}px, ${translateZ}px)
          `;

          // per-card glow color/position
          const distance = Math.hypot(nx - dx, ny - dy);
          const intensity = Math.max(0, 1 - distance * 1.5);
          const hue = 190 + intensity * 40; // blue → cyan
          item.style.setProperty(
            "--glow-color",
            \`hsla(\${hue}, 90%, 70%, \${0.5 * intensity})\`
          );
        });
      };

      const reset = () => {
        items.forEach((item) => {
          item.style.transform = "";
          item.style.setProperty(
            "--glow-color",
            "hsla(200, 90%, 70%, 0)"
          );
        });
      };

      grid.addEventListener("pointermove", handleMove);
      grid.addEventListener("pointerleave", reset);
    }
  </script>
</section>

---
import Knap from "./Knap.astro";
import { Image } from "astro:assets";
import { supabase } from "../lib/supabaseClient";
const { item } = Astro.props;

// Construct the paths
const wideImgPath = `cardImgs/${item.slug}_wide.webp`;
const tallImgPath = `cardImgs/${item.slug}_tall.webp`;
const squareImgPath = `cardImgs/${item.slug}_square.webp`;

// Get the public URLs
const wideImgUrl = supabase.storage.from("Portfolio").getPublicUrl(wideImgPath)
  .data.publicUrl;

const tallImgUrl = supabase.storage.from("Portfolio").getPublicUrl(tallImgPath)
  .data.publicUrl;
const squareImgUrl = supabase.storage
  .from("Portfolio")
  .getPublicUrl(squareImgPath).data.publicUrl;
---

<a
  class="productcard overflow-hidden w-full lg:w-1/2 xl:w-1/3 p-2 py-6 hover:[&_h3]:underline"
  href={"../undersider/" + item.slug}
>
  <div
    class="imgcontainer rounded-sm aspect-[3/2] xl:aspect-square w-full relative overflow-hidden"
  >
    {
      /* <div class="absolute left-0 top-0 p-4 flex gap-2 ">
          {tags.map((tag, index) => (
            <div key={index} class="border rounded-full px-3 py-0.5 text-secondary">
              {tag}
            </div>
          ))}
        </div> */
    }

    <img
      class="object-cover h-full"
      src={squareImgUrl}
      alt={"billede af " + item.name}
    />
  </div>

  <div class="w-full mt-4 flex justify-center items-start flex-col">
    <h3 class="!font-serif text-2xl mb-2 text- tracking-tight">
      {item.name}
    </h3>
    <p class="text- text-lg tracking-tight !max-w-[35ch]">
      {item.shortDescription}
    </p>
  </div>
</a>

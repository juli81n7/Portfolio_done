---
import Card from "../components/Card.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Knap from "../components/Knap.astro";
import "../styles/general.css";
import { supabase } from "../lib/supabaseClient";
import ListCard from "../components/List_card.astro";
import { getProcessedPortfolio } from "../lib/data";
import Analytics from "@vercel/analytics/astro";
import Image from "astro/components/Image.astro";

// Fetch projects from Supabase
// Get all files in the 'gallery' folder of the 'Portfolio' bucket
const { data: galleryFiles, error } = await supabase.storage
  .from("Portfolio")
  .list("galleri", {
    limit: 100, // adjust as needed
    offset: 0,
    sortBy: { column: "name", order: "asc" },
  });

if (error) {
  console.error("Error listing files:", error);
  // Handle error as needed
}

const mediaFiles = galleryFiles
  .filter((file) => file.metadata?.mimetype?.match(/^(image|video)\//i))
  .map((file) => {
    // Remove file extension
    const nameWithoutExtension = file.name.replace(/\.[^/.]+$/, "");
    return {
      url: supabase.storage
        .from("Portfolio")
        .getPublicUrl(`galleri/${file.name}`).data.publicUrl,
      mimetype: file.metadata.mimetype,
      name: file.name,
      nameWithoutExtension,
    };
  });
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="../../svg/logo.svg" />
    <meta name="viewport" content="width=device-width" />
    <Analytics />
    <meta name="generator" content={Astro.generator} />
    <link rel="stylesheet" href="https://use.typekit.net/fmg2iph.css" />
    <title>Julius Elikofer - Atelieret</title>
  </head>
  <body>
    <Header />
    <main class="max-w-[1800px] !mx-auto">
      <div class="header !my-4">
        <div>
          <h1 class="!font-serif">Atelieret</h1>
          <p class="!max-w-[60ch] !mt-4 !font-bold !tracking-tighter">
            Velkommen til Atelieret – et kig ind i mit kreative værksted. Her
            viser jeg små udpluk af projekter, der ikke fylder nok til fulde
            cases, men stadig fortjener en plads i mit galleri.
          </p>
        </div>
      </div>

      <section
        class="!mx-4 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4 max-w-[1800px] 2xl:mx-auto"
      >
        {
          mediaFiles.map((file) =>
            file.mimetype.startsWith("image/") ? (
              <div class="z-10 overflow-hidden relative  !mb-4 xl:!mb-0 w-full !rounded-lg flex flex-col justify-center items-start">
                <img
                  class="z-10 relative object-contain  rounded-lg"
                  decoding="async"
                  loading="lazy"
                  src={file.url}
                  alt={file.name}
                />

                <p class="z-10 !font-bold !tracking-tighter  !text-xs !mt-4 ">
                  {file.nameWithoutExtension}
                </p>
                <div class="z-0  absolute w-full h-full top-0 left-0 opacity-5" />
              </div>
            ) : file.mimetype.startsWith("video/") ? (
              <div
                class={`z-10 overflow-hidden relative !mb-4 xl:!mb-0 w-full !rounded-lg flex flex-col justify-center items-start`}
              >
                <video
                  class="z-10 object-fill w-full !rounded-lg"
                  src={file.url}
                  autoplay
                  muted
                  playsinline

                >
                  Your browser does not support the video tag.
                </video>
                <p class="!font-bold z-10 !tracking-tighter  !text-xs !mt-4 ">
                  {file.nameWithoutExtension}
                </p>
                <div class="z-0  absolute w-full h-full top-0 left-0 opacity-5" />
              </div>
            ) : null,
          )
        }
      </section>
    </main>
    <Footer />
  </body>
  <style>
    main {
      margin-top: 5.5rem;

      & .project {
        & h2 {
          font-size: 5rem;
          line-height: 4rem;
          text-transform: uppercase;
        }
        margin-top: 5rem;
        display: grid;
        grid-template-columns: 1.5fr 1fr;

        gap: 2rem;
        margin-left: 1rem;
        margin-right: 1rem;

        &:nth-child(odd) {
          grid-template-columns: 1fr 1.5fr;
          .img_container {
            order: 1;
          }
        }

        & .img_container {
          overflow: hidden;
          border-radius: 1rem;
          height: 100%;
          height: 500px;

          & img {
            min-height: 100%;
            width: 100%;
            object-fit: cover;
          }
        }
        & .text {
          display: flex;
          flex-direction: column;
          justify-content: center;
          align-items: flex-start;

          & p {
            max-width: 30ch;
            margin-bottom: 0.5rem;
          }
        }
        @media (width<800px) {
          display: block;
          & h2 {
            margin-top: 1rem;
            font-size: 2rem;
            line-height: 2rem;
          }
          & .text {
            display: block;
            grid-template-columns: 1fr 1fr;
            & h2 {
              grid-column: 1/-1;
            }
            & p {
              grid-column: 1;
            }
            & a {
              grid-column: 1;
            }
          }
        }
      }
    }
    p {
      max-width: 100ch;
    }
    .shelf {
      overflow: hidden;
      overflow-x: scroll;
      scroll-behavior: smooth;
      margin-top: 1rem;
      cursor: url(public/svg/move_white.svg), auto !important;
      padding-bottom: 1rem;
      scroll-snap-type: x mandatory;
    }

    .wrapper {
      display: flex;
      gap: 0.5rem;
      margin-left: 1rem;
    }

    .wrapper:after {
      content: "";
      padding-right: 5rem;
    }

    .header {
      display: flex;
      justify-content: space-between;
      margin-right: 1rem;
      align-items: flex-end;
      margin-left: 1rem;
      gap: 1rem;
    }

    @media (max-width: 800px) {
      .header {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        margin-right: 1rem;
        align-items: flex-start;
      }
      .container {
      }
    }
  </style>
</html>
